
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Customers | Mimic Haven Collectibles</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin-layout.css?v=1">
    <link rel="stylesheet" href="/admin-customers.css?v=1">
</head>

<body>

<div class="admin-layout">

    {# SHARED ADMIN SIDEBAR #}
    {% include 'admin/_sidebar.html.twig' with { activePage: 'customers' } %}

    <!-- MAIN CONTENT -->
    <main class="admin-main">

        <div class="admin-content customers-content">

            <!-- PAGE HEADER -->
            <header class="customers-page-header">
                <h1>Manage Customers</h1>
            </header>

            <!-- RELIABILITY GUIDE -->
            <section class="reliability-guide" aria-label="Reliability score guide">

                <div class="guide-card">
                    <strong class="excellent">90–100</strong>
                    <span>Excellent</span>
                </div>

                <div class="guide-card">
                    <strong class="good">70–89</strong>
                    <span>Good</span>
                </div>

                <div class="guide-card">
                    <strong class="fair">50–69</strong>
                    <span>Fair</span>
                </div>

                <div class="guide-card">
                    <strong class="low">0–49</strong>
                    <span>Low</span>
                </div>

            </section>

            <!-- CUSTOMERS TABLE -->
            <section class="customers-table-section">

                <div class="customers-table-header">
                    <div>
                        <h2>Customer Records</h2>
                        <p>Customer accounts and pre-order reliability information.</p>
                    </div>

                    <span class="customers-count">
                        {{ customers|length }} Customers
                    </span>
                </div>

                <div class="table-wrapper">

                    <table class="table customers-table mb-0">

                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Email</th>
                                <th>Completed</th>
                                <th>Cancelled</th>
                                <th>Reliability Score</th>
                                <th>Rating</th>
                                <th>Member Since</th>
                            </tr>
                        </thead>

                        <tbody>

                        {% for customer in customers %}

                            <tr>

                                <!-- CUSTOMER INFORMATION -->
                                <td>
                                    <div class="customer-name">
                                        {{ customer.first_name }} {{ customer.last_name }}
                                    </div>

                                    <div class="customer-id">
                                        Account #{{ customer.id }}
                                    </div>
                                </td>

                                <!-- EMAIL -->
                                <td class="customer-email">
                                    {{ customer.email }}
                                </td>

                                <!-- COMPLETED PREORDERS -->
                                <td>
                                    <span class="activity-number">
                                        {{ customer.completed_preorders }}
                                    </span>
                                </td>

                                <!-- CANCELLED PREORDERS -->
                                <td>
                                    <span class="activity-number
                                        {{ customer.cancelled_preorders > 0 ? 'has-cancellations' : '' }}
                                    ">
                                        {{ customer.cancelled_preorders }}
                                    </span>
                                </td>

                                <!-- RELIABILITY SCORE -->
                                <td>
                                    <span class="score-number {{ customer.reliability_class }}">
                                        {{ customer.reliability_score|number_format(2, '.', ',') }}
                                    </span>
                                </td>

                                <!-- RELIABILITY RATING -->
                                <td>
                                    <span class="rating-badge {{ customer.reliability_class }}">
                                        {{ customer.reliability_label }}
                                    </span>
                                </td>

                                <!-- MEMBER SINCE -->
                                <td class="member-date">
                                    {{ customer.created_at|date('M d, Y') }}
                                </td>

                            </tr>

                        {% else %}

                            <tr>
                                <td colspan="7" class="empty">
                                    No customers found.
                                </td>
                            </tr>

                        {% endfor %}

                        </tbody>

                    </table>

                </div>

            </section>

            <!-- RELIABILITY EXPLANATION -->
            <div class="customers-legend">
                <span class="legend-indicator"></span>

                Reliability is calculated from completed and cancelled
                pre-orders. Each cancellation reduces the score by 20 points.
            </div>

            <!-- BACK TO DASHBOARD -->
            <a href="/admin" class="customers-back">
                ← Back to Admin Dashboard
            </a>

        </div>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
