
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Orders | Mimic Haven Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin-layout.css?v=1">
    <link rel="stylesheet" href="/admin-orders.css?v=10">
</head>

<body>

<div class="admin-layout">

    {# SHARED ADMIN SIDEBAR #}
    {% include 'admin/_sidebar.html.twig' with { activePage: 'orders' } %}

    <!-- MAIN CONTENT -->
    <main class="admin-main">
        <div class="admin-content">

            <!-- PAGE HEADER -->
            <div class="orders-page-header">
                <h1>Orders</h1>
            </div>

            <!-- SUCCESS MESSAGES -->
            {% for message in app.flashes('success') %}
                <div class="alert alert-success orders-alert" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            <!-- ERROR MESSAGES -->
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger orders-alert" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            <!-- ORDERS LIST -->
            {% if orders is empty %}

                <div class="card orders-order-card empty-orders">
                    <div class="card-body">
                        <h2 class="h5 mb-2">No orders found</h2>
                        <p class="text-secondary mb-0">
                            Customer orders will appear here.
                        </p>
                    </div>
                </div>

            {% else %}

                {% for order in orders %}

                    <div class="card orders-order-card mb-4">
                        <div class="card-body p-4">

                            <!-- ORDER HEADER -->
                            <div class="order-header">

                                <div>
                                    <div class="orders-order-number">
                                        ORDER #{{ order.id }}
                                    </div>

                                    <h2 class="order-customer-name">
                                        {{ order.first_name }} {{ order.last_name }}
                                    </h2>

                                    <p class="order-customer-email">
                                        {{ order.email }}
                                    </p>
                                </div>

                                <span class="badge orders-status
                                    {% if order.status|lower in ['completed', 'complete'] %}
                                        bg-success
                                    {% else %}
                                        bg-secondary
                                    {% endif %}
                                ">
                                    {{ order.status|replace({'_': ' '})|title }}
                                </span>

                            </div>

                            <hr class="orders-divider">

                            <!-- ORDER DETAILS -->
                            <div class="row row-cols-1 row-cols-lg-3 g-3">

                                <div class="col">
                                    <div class="order-detail">
                                        <span>Order Date</span>
                                        <strong>
                                            {{ order.created_at|date('M d, Y') }}
                                        </strong>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="order-detail">
                                        <span>Payment Method</span>
                                        <strong>
                                            {{ order.payment_method|default('Not specified') }}
                                        </strong>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="order-detail">
                                        <span>Total Amount</span>
                                        <strong class="orders-total">
                                            ₱{{ order.total_amount|number_format(2, '.', ',') }}
                                        </strong>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="order-detail order-address">
                                        <span>Delivery Address</span>
                                        <strong>
                                            {{ order.delivery_address|default('No delivery address provided') }}
                                        </strong>
                                    </div>
                                </div>

                            </div>

                            <hr class="orders-divider">

                            <!-- UPDATE ORDER STATUS -->
                            <form
                                method="POST"
                                action="{{ path('app_admin_orders') }}"
                                class="orders-status-form"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('admin_order_status_' ~ order.id) }}"
                                >

                                <input
                                    type="hidden"
                                    name="order_id"
                                    value="{{ order.id }}"
                                >

                                <div class="row g-3 align-items-end">

                                    <div class="col-12 col-lg-7">
                                        <label
                                            for="status-{{ order.id }}"
                                            class="form-label"
                                        >
                                            Update Order Status
                                        </label>

                                        <select
                                            name="status"
                                            id="status-{{ order.id }}"
                                            class="form-select"
                                        >
                                            {% for status in allowedStatuses %}
                                                <option
                                                    value="{{ status }}"
                                                    {% if order.status == status %}selected{% endif %}
                                                >
                                                    {{ status|replace({'_': ' '})|title }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col-12 col-lg-5">
                                        <button
                                            type="submit"
                                            class="btn orders-update-btn"
                                        >
                                            Update Status
                                        </button>
                                    </div>

                                </div>

                            </form>

                        </div>
                    </div>

                {% endfor %}

            {% endif %}

        </div>
    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
