
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Products | Mimic Haven Collectibles</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin-layout.css?v=1">
    <link rel="stylesheet" href="/admin-products.css?v=1">
</head>

<body>

<div class="admin-layout">

    {# SHARED ADMIN SIDEBAR #}
    {% include 'admin/_sidebar.html.twig' with { activePage: 'products' } %}

    <!-- MAIN CONTENT -->
    <main class="admin-main">

        <div class="admin-content products-content">

            <!-- PAGE HEADER -->
            <header class="products-page-header">
                <div>
                    <h1>Manage Products</h1>
                    <p>Add, edit, classify, and maintain collectible products.</p>
                </div>
            </header>

            <!-- SUCCESS MESSAGES -->
            {% for message in app.flashes('success') %}
                <div class="alert alert-success products-alert" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            <!-- ERROR MESSAGES -->
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger products-alert" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            <!-- =====================================
                 ADD PRODUCT
            ====================================== -->

            <section class="add-card card">

                <div class="card-body">

                    <div class="products-section-header">
                        <h2>Add Product</h2>
                        <p>Enter the details of the collectible product.</p>
                    </div>

                    <form method="post" action="{{ path('app_admin_products') }}">

                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('admin_products') }}"
                        >

                        <input
                            type="hidden"
                            name="action"
                            value="add"
                        >

                        <div class="form-grid">

                            <div class="form-group">
                                <label for="add-name">Product Name</label>
                                <input
                                    id="add-name"
                                    class="form-control"
                                    type="text"
                                    name="name"
                                    maxlength="150"
                                    required
                                >
                            </div>

                            <div class="form-group">
                                <label for="add-series">Series</label>
                                <input
                                    id="add-series"
                                    class="form-control"
                                    type="text"
                                    name="series"
                                    maxlength="100"
                                    required
                                >
                            </div>

                            <div class="form-group">
                                <label for="add-category">Category</label>
                                <select
                                    id="add-category"
                                    class="form-select"
                                    name="category"
                                    required
                                >
                                    <option value="">Select Category</option>

                                    {% for category in categories %}
                                        <option value="{{ category }}">
                                            {{ category }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="add-availability">Availability</label>
                                <select
                                    id="add-availability"
                                    class="form-select"
                                    name="availability"
                                    required
                                >
                                    {% for availability in availabilities %}
                                        <option value="{{ availability }}">
                                            {{ availability }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="add-condition">Condition</label>
                                <select
                                    id="add-condition"
                                    class="form-select"
                                    name="condition_status"
                                    required
                                >
                                    {% for condition in conditions %}
                                        <option value="{{ condition }}">
                                            {{ condition }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="add-price">Price (₱)</label>
                                <input
                                    id="add-price"
                                    class="form-control"
                                    type="number"
                                    name="price"
                                    min="0"
                                    step="0.01"
                                    required
                                >
                            </div>

                            <div class="form-group">
                                <label for="add-stock">Stock</label>
                                <input
                                    id="add-stock"
                                    class="form-control"
                                    type="number"
                                    name="stock"
                                    min="0"
                                    step="1"
                                    value="0"
                                    required
                                >
                            </div>

                            <div class="form-group">
                                <label for="add-image">Image Path</label>
                                <input
                                    id="add-image"
                                    class="form-control"
                                    type="text"
                                    name="image"
                                    maxlength="255"
                                    placeholder="example.webp"
                                >
                            </div>

                            <div class="form-group full">
                                <label for="add-description">Description</label>
                                <textarea
                                    id="add-description"
                                    class="form-control"
                                    name="description"
                                    maxlength="5000"
                                ></textarea>
                            </div>

                            <div class="form-group full">
                                <button type="submit" class="btn primary-button">
                                    Add Product
                                </button>
                            </div>

                        </div>

                    </form>

                </div>

            </section>

            <!-- =====================================
                 PRODUCT TABLE
            ====================================== -->

            <section class="products-list-section">

                <div class="products-list-header">
                    <div>
                        <h2>Product Inventory</h2>
                        <p>View and manage your collectible products.</p>
                    </div>

                    <span class="products-count">
                        {{ products|length }} Products
                    </span>
                </div>

                <div class="table-wrapper">

                    <table class="table products-table mb-0">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Availability</th>
                                <th>Condition</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                        {% for product in products %}

                            <tr>

                                <!-- PRODUCT INFORMATION -->
                                <td>
                                    <div class="product-cell">

                                        {% if product.image_url %}
                                            <img
                                                src="{{ product.image_url }}"
                                                alt="{{ product.name }}"
                                                loading="lazy"
                                            >
                                        {% else %}
                                            <div class="image-placeholder">
                                                No image
                                            </div>
                                        {% endif %}

                                        <div class="product-information">

                                            <div class="product-name">
                                                {{ product.name }}
                                            </div>

                                            <div class="muted">
                                                {{ product.series }}
                                            </div>

                                            <div class="muted">
                                                ID: {{ product.id }}
                                            </div>

                                        </div>

                                    </div>
                                </td>

                                <!-- CATEGORY -->
                                <td>
                                    <span class="tag">
                                        {{ product.category }}
                                    </span>
                                </td>

                                <!-- AVAILABILITY -->
                                <td>
                                    {{ product.availability }}
                                </td>

                                <!-- CONDITION -->
                                <td>
                                    {{ product.condition_status }}
                                </td>

                                <!-- PRICE -->
                                <td>
                                    <strong class="product-price">
                                        ₱{{ product.price|number_format(2, '.', ',') }}
                                    </strong>
                                </td>

                                <!-- STOCK -->
                                <td>
                                    {{ product.stock ?? 0 }}
                                </td>

                                <!-- ACTIONS -->
                                <td>

                                    <div class="actions">

                                        <!-- EDIT PRODUCT -->
                                        <details class="product-edit-details">

                                            <summary>
                                                Edit
                                            </summary>

                                            <div class="edit-form">

                                                <form
                                                    method="post"
                                                    action="{{ path('app_admin_products') }}"
                                                >

                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('admin_products') }}"
                                                    >

                                                    <input
                                                        type="hidden"
                                                        name="action"
                                                        value="update"
                                                    >

                                                    <input
                                                        type="hidden"
                                                        name="product_id"
                                                        value="{{ product.id }}"
                                                    >

                                                    <div class="edit-form-header">
                                                        <h3>Edit Product</h3>
                                                        <p>
                                                            Update the information for
                                                            {{ product.name }}.
                                                        </p>
                                                    </div>

                                                    <div class="form-grid">

                                                        <div class="form-group">
                                                            <label>Product Name</label>
                                                            <input
                                                                class="form-control"
                                                                type="text"
                                                                name="name"
                                                                maxlength="150"
                                                                value="{{ product.name }}"
                                                                required
                                                            >
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Series</label>
                                                            <input
                                                                class="form-control"
                                                                type="text"
                                                                name="series"
                                                                maxlength="100"
                                                                value="{{ product.series }}"
                                                                required
                                                            >
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Category</label>
                                                            <select
                                                                class="form-select"
                                                                name="category"
                                                                required
                                                            >
                                                                {% for category in categories %}
                                                                    <option
                                                                        value="{{ category }}"
                                                                        {% if product.category == category %}selected{% endif %}
                                                                    >
                                                                        {{ category }}
                                                                    </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Availability</label>
                                                            <select
                                                                class="form-select"
                                                                name="availability"
                                                                required
                                                            >
                                                                {% for availability in availabilities %}
                                                                    <option
                                                                        value="{{ availability }}"
                                                                        {% if product.availability == availability %}selected{% endif %}
                                                                    >
                                                                        {{ availability }}
                                                                    </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Condition</label>
                                                            <select
                                                                class="form-select"
                                                                name="condition_status"
                                                                required
                                                            >
                                                                {% for condition in conditions %}
                                                                    <option
                                                                        value="{{ condition }}"
                                                                        {% if product.condition_status == condition %}selected{% endif %}
                                                                    >
                                                                        {{ condition }}
                                                                    </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Price (₱)</label>
                                                            <input
                                                                class="form-control"
                                                                type="number"
                                                                name="price"
                                                                min="0"
                                                                step="0.01"
                                                                value="{{ product.price }}"
                                                                required
                                                            >
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Stock</label>
                                                            <input
                                                                class="form-control"
                                                                type="number"
                                                                name="stock"
                                                                min="0"
                                                                step="1"
                                                                value="{{ product.stock ?? 0 }}"
                                                                required
                                                            >
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Image Path</label>
                                                            <input
                                                                class="form-control"
                                                                type="text"
                                                                name="image"
                                                                maxlength="255"
                                                                value="{{ product.image ?? '' }}"
                                                            >
                                                        </div>

                                                        <div class="form-group full">
                                                            <label>Description</label>
                                                            <textarea
                                                                class="form-control"
                                                                name="description"
                                                                maxlength="5000"
                                                            >{{ product.description ?? '' }}</textarea>
                                                        </div>

                                                        <div class="form-group full">
                                                            <button
                                                                type="submit"
                                                                class="btn primary-button"
                                                            >
                                                                Save Changes
                                                            </button>
                                                        </div>

                                                    </div>

                                                </form>

                                            </div>

                                        </details>

                                        <!-- DELETE PRODUCT -->
                                        <form
                                            method="post"
                                            action="{{ path('app_admin_products') }}"
                                            onsubmit="return confirm('Delete this product? This cannot be undone.');"
                                        >

                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('admin_products') }}"
                                            >

                                            <input
                                                type="hidden"
                                                name="action"
                                                value="delete"
                                            >

                                            <input
                                                type="hidden"
                                                name="product_id"
                                                value="{{ product.id }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn danger-button"
                                            >
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        {% else %}

                            <tr>
                                <td colspan="7" class="empty">
                                    No products found.
                                </td>
                            </tr>

                        {% endfor %}

                        </tbody>

                    </table>

                </div>

            </section>

        </div>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
