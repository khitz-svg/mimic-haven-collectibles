<!doctype html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order #{{ order.id }} | Mimic Haven Collectibles</title>
    <link rel="stylesheet" href="{{ asset('style.css') }}">
</head>
<body>
<header class="site-header" id="home">
    <div class="header-inner">
        <a class="brand" href="{{ path('app_home') }}" aria-label="Mimic Haven Collectibles">
            <img class="brand-logo" src="{{ asset('assets/logo.svg') }}" alt="Mimic Haven Collectibles">
        </a>
        <nav class="nav" id="main-nav" aria-label="Primary navigation">
            <a href="{{ path('app_home') }}">Home</a>
            <a href="{{ path('app_collection') }}">Collection</a>
            <a href="/preorder">Pre-Orders</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a class="nav-icon cart-button" href="{{ path('app_cart') }}" aria-label="Shopping cart">
                <img src="{{ asset('assets/icons/pre-order.png') }}" alt="Cart">
                <span id="cart-count">0</span>
            </a>
            <a class="nav-user" href="{{ path('app_account') }}">Hi, {{ app.user.firstName|e }}</a>
            <a class="nav-account" href="{{ path('app_logout') }}">Logout</a>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">☰</button>
    </div>
</header>

<main class="account-page">
    <section class="account-hero">
        <div class="account-container">
            <span class="account-eyebrow">MIMIC HAVEN COLLECTIBLES</span>
            <h1>Order <span>#{{ order.id }}</span></h1>
            <p>View the complete details of your order.</p>
        </div>
    </section>

    <section class="account-content">
        <div class="account-container">
            <div style="margin-bottom: 24px;">
                <a href="{{ path('app_account') }}" class="account-action secondary">← Back to My Account</a>
            </div>

            <section class="account-card">
                <div class="account-card-header">
                    <div>
                        <span class="account-label">ORDER #{{ order.id }}</span>
                        <h2>Order Details</h2>
                    </div>
                    <span class="account-order-status">{{ order.status|default('Pending')|e }}</span>
                </div>
                <div class="account-info">
                    <div class="account-info-row"><span>Order Date</span><strong>{{ order.created_at|date('F j, Y g:i A') }}</strong></div>
                    <div class="account-info-row"><span>Payment Method</span><strong>{{ order.payment_method|e }}</strong></div>
                    <div class="account-info-row"><span>Order Status</span><strong>{{ order.status|default('Pending')|e }}</strong></div>
                    <div class="account-info-row"><span>Total Amount</span><strong>₱{{ order.total_amount|number_format(2, '.', ',') }}</strong></div>
                </div>
            </section>

            <section class="account-card" style="margin-top: 24px;">
                <div class="account-card-header">
                    <div><span class="account-label">PURCHASED ITEMS</span><h2>Your Figures</h2></div>
                </div>
                {% if items is empty %}
                    <div class="account-empty">
                        <div class="account-empty-icon">✦</div>
                        <h3>No items found</h3>
                        <p>The items for this order could not be found.</p>
                    </div>
                {% else %}
                    <div class="account-orders">
                        {% for item in items %}
                            <article class="account-order">
                                <div class="account-order-item">
                                    <div class="account-order-image">
                                        {% if item.image_path %}
                                            <img src="{{ item.image_path }}" alt="{{ item.name|default('Product')|e }}">
                                        {% else %}
                                            <div class="account-order-image-placeholder">✦</div>
                                        {% endif %}
                                    </div>
                                    <div class="account-order-details">
                                        <strong>{{ item.name|default('Product')|e }}</strong>
                                        {% if item.series %}<span>{{ item.series|e }}</span>{% endif %}
                                        <span>Quantity: {{ item.quantity }}</span>
                                    </div>
                                    <div class="account-order-price">₱{{ item.price|number_format(2, '.', ',') }}</div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            <section class="account-card" style="margin-top: 24px;">
                <div class="account-card-header">
                    <div><span class="account-label">DELIVERY</span><h2>Shipping Information</h2></div>
                </div>
                <div class="account-order-address">
                    <span>Delivery Address</span>
                    <p>{{ order.delivery_address|e|nl2br }}</p>
                </div>
                {% if order.order_notes %}
                    <div class="account-order-address" style="margin-top: 20px;">
                        <span>Order Notes</span>
                        <p>{{ order.order_notes|e|nl2br }}</p>
                    </div>
                {% endif %}
            </section>

            <section class="account-card" style="margin-top: 24px;">
                <div class="account-order-footer">
                    <div><span>Payment Method</span><strong>{{ order.payment_method|e }}</strong></div>
                    <div><span>Order Total</span><strong>₱{{ order.total_amount|number_format(2, '.', ',') }}</strong></div>
                </div>
            </section>

            <section class="account-actions">
                <a href="{{ path('app_collection') }}" class="account-action secondary">Continue Shopping</a>
                <a href="{{ path('app_account') }}" class="account-action">Back to My Account</a>
            </section>
        </div>
    </section>
</main>
<script src="{{ asset('script.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
