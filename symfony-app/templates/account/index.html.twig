<!doctype html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account | Mimic Haven Collectibles</title>
    <meta name="description" content="View your orders, pre-orders, payments, and customer information.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('style.css') }}">
    <link rel="stylesheet" href="{{ asset('account.css') }}">
</head>
<body>
<header class="site-header" id="home">
    <div class="header-inner">
        <a class="brand" href="{{ path('app_home') }}" aria-label="Mimic Haven Collectibles">
            <img class="brand-logo" src="{{ asset('assets/logo.svg') }}" alt="Mimic Haven Collectibles">
        </a>
        <nav class="nav" id="main-nav" aria-label="Primary navigation">
            <a href="{{ path('app_home') }}">Home</a>
            <a href="{{ path('app_collection') }}">Collection</a>
            <a href="/preorder">Pre-Orders</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a class="nav-icon" href="{{ path('app_collection') }}#collection-search" aria-label="Search">
                <img src="{{ asset('assets/icons/search.svg') }}" alt="Search">
            </a>
            <a class="nav-icon cart-button" href="{{ path('app_cart') }}" aria-label="Cart">
                <img src="{{ asset('assets/icons/pre-order.png') }}" alt="Cart">
                <span id="cart-count">0</span>
            </a>
            <a class="nav-user" href="{{ path('app_account') }}">Hi, {{ user.first_name|e }}</a>
            <a class="nav-account" href="{{ path('app_logout') }}">Logout</a>
            <a class="browse-btn" href="{{ path('app_collection') }}">Browse Figures</a>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">☰</button>
    </div>
</header>

<main>
    <section class="account-page">
        <div class="account-heading">
            <span>COLLECTOR ACCOUNT</span>
            <h1>My Account</h1>
            <p>Welcome back, {{ user.first_name|e }}. Manage your orders, pre-orders, and payments here.</p>
        </div>

        <div class="account-profile">
            <div class="account-card">
                <span class="account-label">CUSTOMER</span>
                <h2>{{ (user.first_name ~ ' ' ~ user.last_name)|e }}</h2>
                <p>{{ user.email|e }}</p>
                <p>Member since {{ user.created_at|date('F Y') }}</p>
            </div>
            <div class="account-card">
                <span class="account-label">RELIABILITY SCORE</span>
                <p class="account-number">{{ user.reliability_score|number_format(0, '.', ',') }}</p>
                <p>Based on completed and cancelled pre-orders.</p>
            </div>
            <div class="account-card">
                <span class="account-label">COMPLETED PRE-ORDERS</span>
                <p class="account-number">{{ user.completed_preorders }}</p>
                <p>Successfully completed reservations.</p>
            </div>
        </div>

        <div class="account-section-heading">
            <div>
                <span class="account-label">PURCHASE HISTORY</span>
                <h2>My Orders</h2>
            </div>
        </div>

        {% if orders is empty %}
            <div class="account-empty">You have not placed any orders yet.</div>
        {% else %}
            {% for order in orders %}
                <article class="account-card account-order">
                    <div class="account-order-header">
                        <div>
                            <h3>Order #{{ order.id }}</h3>
                            <p class="account-order-date">{{ order.created_at|date('F j, Y g:i A') }}</p>
                        </div>
                        <span class="account-order-status">{{ order.status|default('Pending')|e }}</span>
                    </div>

                    {% if order.items is not empty %}
                        <div class="account-products">
                            {% for item in order.items %}
                                <div class="account-product">
                                    <div class="account-product-info">
                                        <div class="account-product-image">
                                            {% if item.image_path %}
                                                <img src="{{ item.image_path }}" alt="{{ item.name|default('Figure')|e }}">
                                            {% endif %}
                                        </div>
                                        <div>
                                            <h4>{{ item.name|default('Anime Figure')|e }}</h4>
                                            <p>{{ item.series|default('')|e }} · Qty: {{ item.quantity }}</p>
                                        </div>
                                    </div>
                                    <div class="account-product-price">₱{{ item.price|number_format(2, '.', ',') }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="account-order-footer">
                        <div class="account-order-total">
                            <span>ORDER TOTAL</span>
                            <strong>₱{{ order.total_amount|number_format(2, '.', ',') }}</strong>
                        </div>
                        <div class="account-actions">
                            <a class="account-action secondary" href="/order?id={{ order.id }}">View Details</a>
                            {% if order.can_review %}
                                <a class="account-action feedback" href="/feedback">★ Leave Feedback</a>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        {% endif %}

        <div class="account-section-heading">
            <div>
                <span class="account-label">RESERVATIONS</span>
                <h2>My Pre-Orders</h2>
            </div>
        </div>

        {% if preorders is empty %}
            <div class="account-empty">You do not have any pre-orders yet.</div>
        {% else %}
            {% for preorder in preorders %}
                <article class="account-card account-preorder">
                    <div class="account-preorder-product">
                        <div class="account-preorder-image">
                            {% if preorder.image_path %}
                                <img src="{{ preorder.image_path }}" alt="{{ preorder.product_name|e }}">
                            {% endif %}
                        </div>
                        <div>
                            <h3>{{ preorder.product_name|e }}</h3>
                            <p>{{ preorder.series|e }} · Qty: {{ preorder.quantity }}</p>
                        </div>
                    </div>

                    <div class="account-preorder-grid">
                        <div class="account-preorder-stat"><span>Status</span><strong>{{ preorder.status|e }}</strong></div>
                        <div class="account-preorder-stat"><span>Release</span><strong>{{ preorder.release_status|e }}</strong></div>
                        <div class="account-preorder-stat"><span>Total</span><strong>₱{{ preorder.total_amount|number_format(2, '.', ',') }}</strong></div>
                        <div class="account-preorder-stat"><span>Remaining Balance</span><strong>₱{{ preorder.remaining_balance|number_format(2, '.', ',') }}</strong></div>
                        <div class="account-preorder-stat"><span>Deposit</span><strong>₱{{ preorder.deposit_amount|number_format(2, '.', ',') }}</strong></div>
                        <div class="account-preorder-stat"><span>Deposit Status</span><strong>{{ preorder.deposit_status|e }}</strong></div>
                        <div class="account-preorder-stat"><span>Balance Paid</span><strong>₱{{ preorder.balance_paid_amount|number_format(2, '.', ',') }}</strong></div>
                        <div class="account-preorder-stat"><span>Balance Status</span><strong>{{ preorder.balance_status|e }}</strong></div>
                    </div>
                </article>
            {% endfor %}
        {% endif %}
    </section>
</main>

<footer id="contact">
    <div class="footer-grid">
        <div>
            <img class="footer-logo" src="{{ asset('assets/logo.svg') }}" alt="Mimic Haven Collectibles">
            <p>A sanctuary for anime collectors, offering authentic figures, trusted pre-orders, and a premium collecting experience inspired by the journey behind every masterpiece.</p>
        </div>
        <div class="footer-links">
            <h4>NAVIGATE</h4>
            <a href="{{ path('app_home') }}">Home</a>
            <a href="{{ path('app_collection') }}">Collection</a>
            <a href="/preorder">Pre-Orders</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
        </div>
        <div class="footer-links">
            <h4>CONNECT</h4>
            <a href="mailto:mimichvn.collectibles@gmail.com">mimichvn.collectibles@gmail.com</a>
            <a href="tel:+639657457775">+63 965 745 7775</a>
            <div class="socials">
                <a href="#" aria-label="Facebook"><img src="{{ asset('assets/icons/facebook.png') }}" alt="Facebook"></a>
                <a href="#" aria-label="Instagram"><img src="{{ asset('assets/icons/instagram.png') }}" alt="Instagram"></a>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <span>© 2026 Mimic Haven Collectibles. All Rights Reserved.</span>
        <span>Crafted with precision &amp; passion.</span>
    </div>
</footer>

<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script src="{{ asset('script.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
